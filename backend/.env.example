# Copie este arquivo para ".env" (mesma pasta) e preencha com a connection
# string do seu Postgres no Neon (neon.tech, plano gratuito sem prazo de
# expiração). No dashboard do Neon: Connect > copie a "connection string"
# (a que tem "-pooler" no nome do host é a recomendada para a aplicação).

DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# Porta em que o backend roda localmente (o Render define isso sozinho em produção)
PORT=3001
